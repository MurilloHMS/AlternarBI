<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox
        prefWidth="500.0"
        prefHeight="250.0"
        spacing="0"
        stylesheets="@../assets/css/theme.css"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.proautokimium.alternarpowerbi.MainController">

    <!-- ═══════════ HEADER ═══════════ -->
    <VBox styleClass="header" spacing="2">
        <padding><Insets bottom="16" left="24" right="24" top="20"/></padding>

        <Label text="Alternar Power BI" styleClass="title"/>
        <Label fx:id="subtitleLabel" styleClass="subtitle"
               text="Configurado: 10 páginas · 45s por página"/>
    </VBox>

    <!-- ═══════════ DISPLAY DE PROGRESSO ═══════════ -->
    <VBox styleClass="card" spacing="10">
        <padding><Insets bottom="16" left="24" right="24" top="16"/></padding>

        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label fx:id="statusLabel" styleClass="status-label"
                   text="Pronto para iniciar"/>
        </HBox>

        <ProgressBar fx:id="progressBar" progress="0.01"
                     minHeight="8" maxWidth="Infinity"/>
    </VBox>

    <!-- ═══════════ CONTROLES ═══════════ -->
    <HBox alignment="CENTER" spacing="20" styleClass="controls-bar">
        <padding><Insets bottom="20" left="24" right="24" top="20"/></padding>

        <Button fx:id="playButton" onAction="#onPlayButtonClick"
                styleClass="btn-play" prefWidth="80" prefHeight="54">
            <graphic>
                <FontAwesomeIconView fill="WHITE" glyphName="PLAY" size="22"/>
            </graphic>
        </Button>

        <Button fx:id="pauseButton" onAction="#onPauseButtonClick"
                styleClass="btn-pause" prefWidth="80" prefHeight="54"
                disable="true">
            <graphic>
                <FontAwesomeIconView fill="WHITE" glyphName="PAUSE" size="22"/>
            </graphic>
        </Button>

        <Button fx:id="stopButton" onAction="#onStopButtonClick"
                styleClass="btn-stop" prefWidth="80" prefHeight="54"
                disable="true">
            <graphic>
                <FontAwesomeIconView fill="WHITE" glyphName="STOP" size="22"/>
            </graphic>
        </Button>

    </HBox>

    <Separator/>

    <!-- ═══════════ CONFIGURAÇÕES (expansível) ═══════════ -->
    <TitledPane fx:id="settingsPane" text="⚙  Configurações" expanded="false"
                styleClass="settings-pane">

        <ScrollPane fitToWidth="true" styleClass="settings-scroll"
                    maxHeight="Infinity">
            <VBox spacing="18">
                <padding><Insets bottom="16" left="16" right="16" top="16"/></padding>

                <!-- Total de páginas -->
                <VBox spacing="6">
                    <Label text="Total de páginas" styleClass="field-label"/>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Spinner fx:id="spinnerPages" min="1" max="200"
                                 initialValue="10" prefWidth="90" editable="true"
                                 styleClass="field-spinner"/>
                        <Label text="páginas" styleClass="field-unit"/>
                    </HBox>
                </VBox>

                <!-- Intervalo padrão -->
                <VBox spacing="6">
                    <Label text="Intervalo padrão (todas as páginas)" styleClass="field-label"/>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Slider fx:id="sliderDefault" min="5" max="300"
                                value="45" blockIncrement="5"
                                showTickMarks="false" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblDefaultSecs" text="45s"
                               styleClass="field-value" prefWidth="40"/>
                    </HBox>
                </VBox>

                <!-- Intervalos individuais por página -->
                <VBox spacing="6">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="Intervalos individuais por página"
                               styleClass="field-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnApplyDefault"
                                text="Resetar para padrão"
                                styleClass="btn-small"
                                onAction="#onApplyDefaultInterval"/>
                    </HBox>

                    <!-- Container gerado dinamicamente pelo controller -->
                    <VBox fx:id="pageIntervalsContainer" spacing="6"/>
                </VBox>

                <!-- Loop -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <CheckBox fx:id="checkLoop"
                              text="Loop contínuo (volta à página 1 ao terminar)"
                              styleClass="field-check" selected="true"
                              onAction="#onLoopChanged"/>
                </HBox>

                <!-- Botão salvar -->
                <HBox alignment="CENTER_RIGHT">
                    <Button text="💾  Salvar configurações"
                            styleClass="btn-save"
                            onAction="#onSaveConfig"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </TitledPane>

</VBox>